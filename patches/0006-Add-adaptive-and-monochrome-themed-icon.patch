From 138cea1ea93a72b8a4ce71dabe76dca71c2af6ed Mon Sep 17 00:00:00 2001
From: Huy7684 <huyplus7684@gmail.com>
Date: Sun, 1 Nov 2026 13:17:10 +0700
Subject: [PATCH] MiuiCamera: Add adaptive icon and monochrome themed icon
 support

---
 res/drawable/ic_camera_bg.xml         |  9 +++++++++
 res/drawable/ic_camera_monochrome.xml | 16 ++++++++++++++++
 res/mipmap-anydpi-v26/f9l.xml         |  6 ++++++
 3 files changed, 31 insertions(+)
 create mode 100644 res/drawable/ic_camera_bg.xml
 create mode 100644 res/drawable/ic_camera_monochrome.xml
 create mode 100644 res/mipmap-anydpi-v26/f9l.xml

diff --git a/res/drawable/ic_camera_bg.xml b/res/drawable/ic_camera_bg.xml
new file mode 100644
index 0000000..37941c9
--- /dev/null
+++ b/res/drawable/ic_camera_bg.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<shape xmlns:android="http://schemas.android.com/apk/res/android"
+    android:shape="rectangle">
+    <gradient
+        android:angle="315"
+        android:startColor="#FFFFFFFF"
+        android:endColor="#FFC8D4E2"
+        android:type="linear" />
+</shape>
diff --git a/res/drawable/ic_camera_monochrome.xml b/res/drawable/ic_camera_monochrome.xml
new file mode 100644
index 0000000..ae840e3
--- /dev/null
+++ b/res/drawable/ic_camera_monochrome.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+    <path
+        android:fillColor="#FFFFFFFF"
+        android:pathData="M 54 22 A 32 32 0 1 0 54 86 A 32 32 0 1 0 54 22 Z M 54 28 A 26 26 0 1 1 54 80 A 26 26 0 1 1 54 28 Z" />
+    <path
+        android:fillColor="#FFFFFFFF"
+        android:pathData="M 54 34 A 20 20 0 1 0 54 74 A 20 20 0 1 0 54 34 Z M 54 39 A 15 15 0 1 1 54 69 A 15 15 0 1 1 54 39 Z" />
+    <path
+        android:fillColor="#FFFFFFFF"
+        android:pathData="M 54 45 A 9 9 0 1 0 54 63 A 9 9 0 1 0 54 45 Z" />
+</vector>
diff --git a/res/mipmap-anydpi-v26/f9l.xml b/res/mipmap-anydpi-v26/f9l.xml
new file mode 100644
index 0000000..f409005
--- /dev/null
+++ b/res/mipmap-anydpi-v26/f9l.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
+    <background android:drawable="@drawable/ic_camera_bg" />
+    <foreground android:drawable="@drawable/ic_camera_fg" />
+    <monochrome android:drawable="@drawable/ic_camera_monochrome" />
+</adaptive-icon>
-- 
2.43.0

