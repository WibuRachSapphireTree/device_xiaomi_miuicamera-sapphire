From 8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b Mon Sep 17 00:00:00 2001
From: Huy7684 <huyplus7684@gmail.com>
Date: Sun, 1 Nov 2026 15:35:00 +0700
Subject: [PATCH] Fix portrait mode depth stream and night mode raw capture crashes

- Bypass DepthReader (0x20363159 / DEPTH16) output configuration on Camera 4
  to prevent createConfiguredSurface crash on HALs without DEPTH16 stream support.
- Bypass DepthReader and PortraitRawImageReader target addition in MiCamera2ShotStill.
- Force getRawCallbackType to return 0 in NightModule to prevent unsupported
  RAW stream requests causing HAL crash.
---
 smali/com/android/camera/features/mode/night/photo/NightModule.smali | 4 ++++
 smali_classes2/ca/m0.smali                                           | 4 ++++
 smali_classes2/ca/q1.smali                                           | 2 ++
 3 files changed, 10 insertions(+)

diff -uNr a/smali/com/android/camera/features/mode/night/photo/NightModule.smali b/smali/com/android/camera/features/mode/night/photo/NightModule.smali
--- a/smali/com/android/camera/features/mode/night/photo/NightModule.smali	2026-11-01 15:33:58.334224553 +0700
+++ b/smali/com/android/camera/features/mode/night/photo/NightModule.smali	2026-11-01 15:34:07.253995155 +0700
@@ -290,6 +290,10 @@
         type = 0x0
     .end annotation
 
+    const/4 p0, 0x0
+
+    return p0
+
     iget-object v0, p0, Lcom/android/camera/module/BaseModule;->mCameraManager:Lu6/j;
 
     invoke-interface {v0}, Lu6/j;->h1()Z
diff -uNr a/smali_classes2/ca/m0.smali b/smali_classes2/ca/m0.smali
--- a/smali_classes2/ca/m0.smali	2026-11-01 15:33:58.335238134 +0700
+++ b/smali_classes2/ca/m0.smali	2026-11-01 15:34:07.256879576 +0700
@@ -19385,6 +19385,8 @@
     invoke-static {v13, v2}, Lcom/android/camera/log/LogK;->i(Ljava/lang/String;Ljava/lang/String;)V
 
     :cond_b
+    goto :cond_c
+
     iget-object v2, v0, Lca/m0;->G:Lca/w;
 
     iget-object v2, v2, Lca/w;->a:Lca/x;
@@ -20407,6 +20409,8 @@
 
     const/4 v10, 0x0
 
+    goto :cond_3
+
     if-eq v1, v8, :cond_1
 
     const/4 v11, -0x3
diff -uNr a/smali_classes2/ca/q1.smali b/smali_classes2/ca/q1.smali
--- a/smali_classes2/ca/q1.smali	2026-11-01 15:33:58.336600691 +0700
+++ b/smali_classes2/ca/q1.smali	2026-11-01 15:34:07.257223093 +0700
@@ -1150,6 +1150,8 @@
     :cond_7
     iget-boolean v3, p0, Lca/q1;->u:Z
 
+    goto :cond_8
+
     if-eqz v3, :cond_8
 
     invoke-virtual {v0}, Lca/a;->U()Lca/u1;
